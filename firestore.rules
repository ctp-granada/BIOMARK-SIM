rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.email.matches('.*@ugr\\.es') &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Perfiles de usuario (lectura pública para la clasificación)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
    }

    // Casos clínicos y catálogo de biomarcadores: lectura pública, escritura solo profesorado
    match /cases/{caseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /biomarkers/{biomarkerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documento para comprobar la conexión: solo lectura
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Progreso de cada alumno: se crea y actualiza desde la app, pero no se borra
    match /student_progress/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /attempts/{attemptId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Encuestas de satisfacción: cada respuesta se puede enviar, pero no modificar ni borrar
    match /satisfaction_surveys/{surveyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Contador de visitas
    match /platform_stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Clasificación de alumnos
    match /student_rankings/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Activación de casos por bloques: la lee todo el alumnado; solo se cambia con la clave
    // del profesorado. La clave viaja en una entrada de teacher_sessions escrita en la misma
    // operación (createdAt == request.time), que nadie puede leer.
    match /teacher_sessions/{sessionId} {
      allow read, delete: if false;
      allow create, update: if request.resource.data.clave == 'acido orotico'
                            && request.resource.data.createdAt == request.time;
    }

    match /course_settings/{settingId} {
      allow read: if true;
      allow write: if request.resource.data.sessionId is string
        && getAfter(/databases/$(database)/documents/teacher_sessions/$(request.resource.data.sessionId)).data.clave == 'acido orotico'
        && getAfter(/databases/$(database)/documents/teacher_sessions/$(request.resource.data.sessionId)).data.createdAt == request.time;
    }
  }
}
